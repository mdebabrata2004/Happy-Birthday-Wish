# =========================================================================
# Git Ignore Configuration
# Suitable for Open-Source Publishing
# =========================================================================

# -----------------------------------------
# VS Code, IDE & Editor Backups
# -----------------------------------------
.history/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# -----------------------------------------
# Operating System Artifacts
# -----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# -----------------------------------------
# Logs & Debug Data
# -----------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# -----------------------------------------
# Firebase Deployment & Cache
# -----------------------------------------
.firebase/
.firebaserc
.dataconnect/

# -----------------------------------------
# Environment Variables & Secrets
# -----------------------------------------
.env
.env.*
!.env.example
*.local

# -----------------------------------------
# Runtime & Temporary Files
# -----------------------------------------
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp

# -----------------------------------------
# Node & Dependencies (if applicable)
# -----------------------------------------
node_modules/
bower_components/
.npm/
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# -----------------------------------------
# Build & Coverage Outputs
# -----------------------------------------
dist/
build/
coverage/
.nyc_output/
lib-cov/
.grunt/
